{
  "name": "sentiora-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "postinstall": "node scripts/patch-node-pty.mjs",
    "patch:node-pty": "node scripts/patch-node-pty.mjs",
    "fix:native-permissions": "node scripts/fix-native-permissions.mjs",
    "test": "npm run test:unit && npm run test:native && npm run test:server && npm run test:fault && npm run test:desktop",
    "test:unit": "node --test --test-timeout=60000 test/session.test.js test/env.test.js test/proc-stat.test.js test/recording.test.js",
    "test:native": "node --test --test-timeout=180000 test/native.test.js test/windows-native.test.js",
    "test:server": "node --test --test-timeout=180000 --test-concurrency=1 test/server.test.js test/session-env.test.js test/stream-server.test.js test/windows-server.test.js test/failed-spawn.test.js test/node-pty-patch.test.js test/mailbox.test.js test/parent-edge.test.js test/handover.test.js test/cancellation.test.js test/mcp-server.test.js test/python-client.test.js test/identity.test.js",
    "test:fault": "node --test --test-timeout=180000 --test-concurrency=1 test/fault-injection.test.js",
    "test:agent": "node --test --test-timeout=180000 test/agent-client.test.js",
    "test:desktop": "node --experimental-strip-types --test --test-timeout=180000 test/desktop-tree.test.js test/desktop-bridge.test.js test/desktop-settings.test.js test/desktop-ipc.test.js test/desktop-native.test.js",
    "desktop": "node apps/desktop/bin/living-terminal.mjs",
    "desktop:install": "npm --prefix apps/desktop ci",
    "desktop:typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:build": "npm --prefix apps/desktop run build",
    "bench:conpty": "node test/bench/conpty-provider-bench.mjs",
    "bench:conpty-kill": "node test/bench/conpty-external-kill.mjs",
    "bench:fd": "node test/bench/fd-exhaustion.mjs",
    "stress": "node test/bench/lifecycle-stress.mjs",
    "stress:assert": "node test/bench/lifecycle-stress.mjs 1 --assert",
    "stress:quick": "node test/bench/lifecycle-stress.mjs 0.25 --assert",
    "endurance": "node test/bench/endurance.mjs",
    "endurance:smoke": "node test/bench/endurance.mjs --tier=smoke --sample-seconds=5",
    "endurance:1h": "node test/bench/endurance.mjs --tier=1h",
    "endurance:8h": "node test/bench/endurance.mjs --tier=8h",
    "endurance:24h": "node test/bench/endurance.mjs --tier=24h"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "@xterm/headless": "^5.5.0"
  }
}
