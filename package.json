{
  "name": "sentiora-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "fix:native-permissions": "node scripts/fix-native-permissions.mjs",
    "test": "npm run test:unit && npm run test:native && npm run test:server && npm run test:desktop",
    "test:unit": "node --test --test-timeout=60000 test/session.test.js",
    "test:native": "node --test --test-timeout=180000 test/native.test.js test/windows-native.test.js",
    "test:server": "node --test --test-timeout=180000 --test-concurrency=1 test/server.test.js test/windows-server.test.js",
    "test:desktop": "node --test --test-timeout=180000 test/desktop-bridge.test.js test/desktop-settings.test.js test/desktop-ipc.test.js test/desktop-native.test.js",
    "desktop": "node apps/desktop/bin/living-terminal.mjs",
    "desktop:install": "npm --prefix apps/desktop ci",
    "desktop:typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:build": "npm --prefix apps/desktop run build",
    "bench:conpty": "node test/bench/conpty-provider-bench.mjs",
    "stress": "node test/bench/lifecycle-stress.mjs",
    "endurance": "node test/bench/endurance.mjs",
    "endurance:smoke": "node test/bench/endurance.mjs --tier=smoke",
    "endurance:1h": "node test/bench/endurance.mjs --tier=1h",
    "endurance:8h": "node test/bench/endurance.mjs --tier=8h",
    "endurance:24h": "node test/bench/endurance.mjs --tier=24h"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "@xterm/headless": "^5.5.0"
  }
}
