node_modules/
.qwen/
*.log

# Endurance and stress time series. These are evidence for a specific run on a
# specific machine, not source: they belong in CI artifacts and in issue comments,
# not in git, where a 24h run would add thousands of lines per execution.
artifacts/

# Build output. apps/desktop/dist is served by the bridge at runtime but is
# reproducible from source with `npm --prefix apps/desktop run build`.
dist/
*.tsbuildinfo

# Python bytecode: the client ships source, and a .pyc is a build artifact of the machine that
# happened to run it (issue #4).
__pycache__/
*.pyc

# Playwright: traces and screenshots from a failed run, never a build input.
test-results/
playwright-report/
