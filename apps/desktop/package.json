{
  "name": "@sentiora/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sentiora Living Terminal desktop UI shell and native session bridge (issue #7, PR1).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
